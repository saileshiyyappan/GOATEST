  "authoritativeFirebaseProject": "HUMAN_CONFIGURATION_REQUIRED",
  "authoritativeOwnerField": "uid",
  "authentication": "Firebase Auth UID; verified UID is authoritative",
  "collections": [
    {"collection":"/users","documentId":"firebaseUid","ownerField":"uid","writer":"HOME user profile service","reader":"HOME owner; authorized caretaker","caretakerAccess":"Explicit monitoredUserIds relationship","input":"Authenticated profile data","output":"User profile and caretaker links","retentionRole":"Account and relationship record","dependencies":["Firebase Auth","Firestore rules"]},
    {"collection":"/phbs","documentId":"firebaseUid","ownerField":"uid","writer":"HOME/PHB service","reader":"Owner only","caretakerAccess":"Not granted by default","input":"Authenticated PHB data","output":"Personal health baseline","retentionRole":"User baseline","dependencies":["Firebase Auth"]},
    {"collection":"/schedules","documentId":"scheduleId","ownerField":"userId mapped to verified UID","writer":"HOME schedule service","reader":"Owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Authenticated schedule","output":"Assessment schedule","retentionRole":"User schedule","dependencies":["Firebase Auth"]},
    {"collection":"/notifications","documentId":"notificationId","ownerField":"uid","writer":"CONDITION after report persistence","reader":"Owner or authorized caretaker where rules allow","caretakerAccess":"Explicit relationship","input":"Persisted report reference","output":"USER/CARETAKER notification","retentionRole":"Delivery record","dependencies":["CONDITION reports"]},
    {"collection":"/qa_sessions","documentId":"qaSessionId","ownerField":"uid (userId is mirrored compatibility metadata)","writer":"HOME Q/A service or CONDITION Q/A bridge","reader":"Owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Submitted Q/A answers","output":"AVAILABLE or Q/A_NOT_AVAILABLE source","retentionRole":"Assessment Q/A","dependencies":["Firebase Auth","DAY"]},
    {"collection":"/test","documentId":"obs_test_<sessionId>","ownerField":"uid","writer":"CONDITION TEST via C50 Admin bridge","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Authenticated CM_PACKET_V1","output":"Authoritative TEST observation","retentionRole":"Input to DAY","dependencies":["SHB","CM_PACKET_V1","Firebase Admin","C50 TEST"]},
    {"collection":"/day","documentId":"obs_day_<test-observation-ids>","ownerField":"uid","writer":"CONDITION DAY","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Three completed TEST observations plus optional Q/A","output":"Authoritative DAY observation","retentionRole":"Input to WEEK","dependencies":["/test","C50 DAY"]},
    {"collection":"/week","documentId":"obs_week_<day-observation-ids>","ownerField":"uid","writer":"CONDITION WEEK","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Seven completed DAY observations","output":"Authoritative WEEK observation","retentionRole":"Input to MONTH","dependencies":["/day","C50 WEEK"]},
    {"collection":"/month","documentId":"obs_month_<week-observation-ids>","ownerField":"uid","writer":"CONDITION MONTH","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"Four completed WEEK observations","output":"Authoritative MONTH observation","retentionRole":"Longitudinal CONDITION result","dependencies":["/week","C50 MONTH"]},
    {"collection":"/reports_test","documentId":"rep_test_<sessionId>","ownerField":"uid","writer":"CONDITION TEST","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"C50 TEST result","output":"Authoritative TEST report","retentionRole":"TEST report","dependencies":["/test"]},
    {"collection":"/reports_day","documentId":"rep_day_<test-observation-ids>","ownerField":"uid","writer":"CONDITION DAY","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"C50 DAY result","output":"Authoritative DAY report","retentionRole":"DAY report","dependencies":["/day"]},
    {"collection":"/reports_week","documentId":"rep_week_<day-observation-ids>","ownerField":"uid","writer":"CONDITION WEEK","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"C50 WEEK result","output":"Authoritative WEEK report","retentionRole":"WEEK report","dependencies":["/week"]},
    {"collection":"/reports_month","documentId":"rep_month_<week-observation-ids>","ownerField":"uid","writer":"CONDITION MONTH","reader":"HOME owner or authorized caretaker","caretakerAccess":"Explicit monitored user relationship","input":"C50 MONTH result","output":"Authoritative MONTH report","retentionRole":"MONTH report","dependencies":["/month"]}
  ],
  "forbiddenAuthoritativeCollections":["/tests","/day_records","/week_records","/month_records","/c50_results","/cm_packets"],
