    "pmt3:integration:test": "tsx src/pmt3IntegrationRunner.ts",
    "pmt4:runtime:test": "tsx src/pmt4RuntimeRunner.ts",
    "pmt5:runtime:test": "tsx src/pmt5RuntimeRunner.ts",
    "accuracy:final:test": "tsx src/finalAccuracyRunner.ts",
